<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="dev.dual5g.permission.CONTROL" android:protectionLevel="signature" />
    <uses-permission android:name="dev.dual5g.permission.CONTROL" />
    <application android:label="Dual SIM 5G Controller" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="单 APK：电话进程中自动把默认数据卡设为 5G 优先、副卡禁用 NR，无需 su 或 KSU 模块" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
